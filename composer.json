{
  "name": "longdhdev/project_holaframework",
  "type": "project",
  "description": "A simple php framework",
  "homepage": "https://github.com/hailong289/hola-framework.git",
  "license": "MIT",
  "authors": [
    {
      "name": "hailong289",
      "email": "longdh.dev@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "App/"
    },
    "classmap": ["App/"]
  },
  "config": {
    "platform-check": false
  },
  "repositories": {
    "path": {
      "type": "path",
      "url": "../package-php-framework"
    }
  },
  "require": {
    "php": ">=8.0",
    "longdhdev/holaframework": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable" : true,
  "extra": {
    "branch-alias": {
      "dev-main": "v1.0.0-dev"
    }
  }
}
